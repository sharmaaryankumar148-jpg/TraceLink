# Copy to .env and change values. .env is git-ignored.

# Database (SQLite by default; PostgreSQL works too: postgresql+psycopg://user:pass@host/db)
# DATABASE_URL=sqlite:///tracelink.db

# Use a long random string in any shared deployment
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# First supervisor account (created only when there are no users)
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-this-password

# inline = no Redis needed; redis = background queue + worker.py
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0
STATS_CACHE_SECONDS=30

# Optional LLM enrichment (pip install google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
